  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
